# Copiez ce fichier en ".env" dans le dossier chatbot-api/

# Cle API Groq (obligatoire) - https://console.groq.com/keys
GROQ_API_KEY=votre_cle_groq_ici

# Origine autorisee en CORS : l'URL du backend Node (PAS celle du navigateur,
# car c'est Node qui appelle ce service, jamais le navigateur directement)
ALLOWED_ORIGIN=http://localhost:4000

# Cle partagee avec backend/.env (memes valeurs des deux cotes).
# Deuxieme barriere independante du JWT : sans elle, ce service refuse
# toute requete meme si son port est accidentellement expose publiquement.
INTERNAL_API_KEY=changez-moi-avec-une-longue-chaine-aleatoire
