# Copiez ce fichier en ".env" et changez les valeurs avant la mise en production

PORT=4000
NODE_ENV=development

# Clé secrète utilisée pour signer les tokens JWT
# IMPORTANT : générez une vraie valeur aléatoire en production, par ex. avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Durée de validité du token
JWT_EXPIRES_IN=8h

# Origine autorisée pour les requêtes CORS (l'URL du frontend, avec credentials)
CORS_ORIGIN=http://localhost:3000

# URL du microservice Python (FastAPI) qui contient la logique du chatbot
# (classification, RAG, transcription vocale, synthèse vocale).
# Ce service ne doit JAMAIS être exposé directement au navigateur.
CHATBOT_API_URL=http://localhost:8001

# Clé partagée avec chatbot-api/.env (même valeur des deux côtés).
# Deuxième barrière indépendante du JWT : protège le microservice Python
# même s'il était accidentellement exposé publiquement.
# Générez-la avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=changez-moi-avec-une-longue-chaine-aleatoire
